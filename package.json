{
  "name": "filament",
  "version": "1.0.0",
  "private": true,
  "description": "Веб-чат с языковой моделью через OpenRouter: потоковый вывод, отмена, понятные ошибки",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
