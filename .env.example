# Ключ OpenRouter. Живёт только на сервере, в браузер не попадает.
# Взять: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Порт бэкенда. Фронт в режиме разработки проксирует сюда /api.
PORT=8787

# Необязательное: OpenRouter показывает это в статистике вашего аккаунта.
APP_URL=http://localhost:5173
APP_TITLE=Filament
