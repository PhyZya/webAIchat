#!/bin/sh
# Последняя преграда перед попаданием секрета в историю git.
#
# Файл .env уже в .gitignore, но игнор снимается одним "git add -f", а из
# истории ключ потом не вычистить — только переписыванием всех коммитов.
# Поэтому проверяем то, что реально уходит в коммит.
#
# Хук лежит в репозитории, а не в .git/hooks, и включается командой:
#   git config core.hooksPath .githooks

staged=$(git diff --cached --name-only)

# 1. Сам файл с переменными окружения в коммите быть не должен никогда.
if printf '%s\n' "$staged" | grep -qxE '\.env(\..*)?'; then
    echo "ОТКАЗ: в коммит попал файл .env — в нём живут секреты." >&2
    echo "Уберите его: git restore --staged .env" >&2
    exit 1
fi

# 2. Ключ мог оказаться вписанным в код руками. Ищем формы ключей
#    OpenRouter, OpenAI и Anthropic в добавляемых строках.
found=$(git diff --cached -U0 | grep -nE '^\+.*(sk-or-v1-[A-Za-z0-9]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,})')

if [ -n "$found" ]; then
    echo "ОТКАЗ: в изменениях найдено что-то похожее на ключ доступа." >&2
    echo "Строки (само значение не печатаем):" >&2
    printf '%s\n' "$found" | sed -E 's/(sk-[A-Za-z0-9_-]{6})[A-Za-z0-9_-]+/\1…/g' >&2
    exit 1
fi

exit 0
