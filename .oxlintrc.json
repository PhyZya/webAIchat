{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**"
  ],
  "rules": {
    "max-depth": [
      "error",
      3
    ],
    "max-params": [
      "error",
      4
    ],
    "no-console": "off",
    "react/react-in-jsx-scope": "off",
    "no-await-in-loop": "off"
  }
}
